# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-secure-random-32-byte-string
TOKEN_ENCRYPTION_KEY=change-me-to-a-valid-fernet-key
CORS_ORIGINS=http://localhost:5173,
FRONTEND_URL=https://cloudefare_page.pages.dev

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/autodm

# --- Social Platform (Instagram) ---
MOCK_SOCIAL_API=true
SOCIAL_CLIENT_ID=mock_instagram_client_id
SOCIAL_CLIENT_SECRET=mock_instagram_client_secret
SOCIAL_REDIRECT_URI=http://localhost:8000/api/v1/social/callback
WEBHOOK_VERIFY_TOKEN=your_webhook_token_secret
GRAPH_API_VERSION=v21.0

# --- AI / LangChain / LangGraph ---
MOCK_LLM=true
AI_ENABLED=true
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=300
AI_GATE_THRESHOLD=0.6
AI_DAILY_CALL_LIMIT=50
DM_MAX_CHARS=1000
LANGGRAPH_CHECKPOINT_DB_URL=postgresql://postgres:postgrespassword@localhost:5432/autodm
GRAPH_RUN_TIMEOUT_SECONDS=60
STUCK_RUN_MINUTES=5

# Dev only - sends prompts to third party; keep OFF in production
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autodm-dev

# --- Tuning ---
DM_MAX_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=10
